# Local Homebrew PostgreSQL (peer/trust auth as your OS user)
DATABASE_URL="postgresql://USER@localhost:5432/kapriz?schema=public"

# Or Docker Compose defaults:
# DATABASE_URL="postgresql://kapriz:kapriz@localhost:5432/kapriz?schema=public"

# Signed session cookie secret (min 32 characters)
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Absolute public site origin used for canonical URLs, Open Graph, sitemap, and JSON-LD
# Example production value: https://www.kapriz.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional email delivery configuration. Leave as "console" for local development.
EMAIL_PROVIDER="console"
EMAIL_FROM="Kapriz <orders@example.com>"

# Google Maps Platform — server-only key for address autocomplete & validation.
# Used exclusively by Next.js API routes / server code (never expose to the browser).
# No NEXT_PUBLIC_* Maps key: the client calls our /api/address/* proxy instead.
# Enable: Places API (New), Address Validation API. Restrict the key by IP/server.
# Without this key, local development falls back to mock address suggestions.
GOOGLE_MAPS_API_KEY=""
